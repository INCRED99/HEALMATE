<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light"
    tools:context=".FirstFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/primary_medical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Module"
            android:textSize="18sp"
            android:textColor="@color/text_grey"
            app:layout_constraintTop_toBottomOf="@id/text_welcome"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Emergency SOS Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_sos"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="@string/emergency_sos"
            app:icon="@android:drawable/ic_dialog_alert"
            android:backgroundTint="#D32F2F"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/text_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_role_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Patient Dashboard"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/button_sos"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Patient Features Grid -->
        <GridLayout
            android:id="@+id/grid_patient_features"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            app:layout_constraintTop_toBottomOf="@id/text_role_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Appointment Booking -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_appoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:contentDescription="@string/book_appointment"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:id="@+id/text_appoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/book_appointment"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Records -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_records"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        android:contentDescription="@string/medical_records"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:id="@+id/text_records"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Records"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Medical Store Locator -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_medicine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_dialog_map"
                        android:contentDescription="@string/store_locator"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:id="@+id/text_medicine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Store Locator"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wellness -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_community"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        android:contentDescription="Community"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:id="@+id/text_community"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Community"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>

        <GridLayout
            android:id="@+id/grid_hospital_features"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/text_role_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Upcoming/Past Appointments -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hospital_appoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming / Past Appointments"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Patient Records -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_patient_records"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_agenda"
                        app:tint="@color/primary_medical" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient Records / Prescriptions"
                        android:gravity="center"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </GridLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>