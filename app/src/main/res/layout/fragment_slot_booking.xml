<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/text_hospital_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hospital Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_medical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_select_date"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Date"
            app:icon="@android:drawable/ic_menu_today"
            app:layout_constraintTop_toBottomOf="@id/text_hospital_name" />

        <TextView
            android:id="@+id/text_selected_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No date selected"
            android:textColor="@color/primary_dark"
            app:layout_constraintTop_toBottomOf="@id/button_select_date"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/text_select_time_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Time Slot"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/text_selected_date"
            app:layout_constraintStart_toStartOf="parent" />

        <GridLayout
            android:id="@+id/grid_slots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/text_select_time_title">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slot_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="10:00 AM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slot_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="11:30 AM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slot_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="02:00 PM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slot_4"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="04:30 PM" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm_booking"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="CONFIRM APPOINTMENT"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/grid_slots" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>