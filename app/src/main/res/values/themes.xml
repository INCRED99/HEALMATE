<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Thehealmate" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_medical</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/surface_tint</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="colorSurfaceVariant">@color/surface_tint</item>

        <!-- Error -->
        <item name="colorError">@color/error_red</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_medical</item>
    </style>

    <style name="Theme.Thehealmate" parent="Base.Theme.Thehealmate" />

    <!-- Toolbar style -->
    <style name="Theme.Thehealmate.Toolbar" parent="">
        <item name="android:background">@color/toolbar_bg</item>
        <item name="titleTextColor">@color/toolbar_title</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>